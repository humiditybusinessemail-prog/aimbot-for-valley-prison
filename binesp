local function notify(text, color)
    toast.Text = "  " .. text
    toast.TextColor3 = color or C.textPri
    toast.Visible = true
    TweenService:Create(toast, TweenInfo.new(0.18), {TextTransparency = 0}):Play()
    task.delay(1.5, function()
        TweenService:Create(toast, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
        task.delay(0.35, function() toast.Visible = false end)
    end)
