-- ─── Toggle rows ─────────────────────────────────────────────────────────────
local ROW_H  = 32
local ROW_GAP = 6
local function rowY(n) return 42 + (n-1) * (ROW_H + ROW_GAP) end

local espEnabled       = true
local showAvailable    = true
local showCooldown     = true
local billboardEnabled = true

local toggleSetters = {}

local function addToggleRow(n, labelText, initVal, onChange)
    local row = makeFrame(window, UDim2.new(1, -16, 0, ROW_H),
        UDim2.fromOffset(8, rowY(n)), C.surface, 3)
    applyCorner(row, 6)
    makeLabel(row, UDim2.new(1, -54, 1, 0), UDim2.fromOffset(10, 0),
        labelText, C.textPri, 13, Enum.Font.Gotham, 4)
    local track, _, setValue = makePillToggle(row, UDim2.new(1, -50, 0.5, -11), 4)
    setValue(initVal)
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            local v = onChange()
            setValue(v)
        end
    end)
    toggleSetters[labelText] = setValue
end

addToggleRow(1, "Bin ESP", espEnabled, function()
    espEnabled = not espEnabled
    statusDot.BackgroundColor3 = espEnabled and C.green or C.textSec
    return espEnabled
end)

addToggleRow(2, "Show Available", showAvailable, function()
    showAvailable = not showAvailable
    return showAvailable
end)

addToggleRow(3, "Show Cooldown", showCooldown, function()
