-- ─── UI helpers ──────────────────────────────────────────────────────────────
local function applyCorner(inst, r)
    Instance.new("UICorner", inst).CornerRadius = UDim.new(0, r)
end

local function applyStroke(inst, color, thickness)
    local s = Instance.new("UIStroke", inst)
    s.Color = color
    s.Thickness = thickness
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
end

local function makeFrame(parent, size, pos, color, zindex)
    local f = Instance.new("Frame")
    f.Size = size; f.Position = pos
    f.BackgroundColor3 = color or C.surface
    f.BorderSizePixel = 0
    f.ZIndex = zindex or 1
    f.Parent = parent
    return f
end

local function makeLabel(parent, size, pos, text, textColor, fontSize, font, zindex)
    local l = Instance.new("TextLabel")
    l.Size = size; l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = textColor or C.textPri
    l.TextSize = fontSize or 13
    l.Font = font or Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.ZIndex = zindex or 2
    l.Parent = parent
    return l
end

local function makeBtn(parent, size, pos, text, bgColor, textColor, zindex)
    local b = Instance.new("TextButton")
    b.Size = size; b.Position = pos
    b.BackgroundColor3 = bgColor or C.raised
    b.Text = text
    b.TextColor3 = textColor or C.textPri
    b.TextSize = 13
    b.Font = Enum.Font.Gotham
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = zindex or 2
    b.Parent = parent
    applyCorner(b, 5)
    return b
end

local function makePillToggle(parent, pos, zindex)
    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(42, 22)
    track.Position = pos
    track.BackgroundColor3 = C.raised
    track.BorderSizePixel = 0
    track.ZIndex = zindex or 2
    track.Parent = parent
    applyCorner(track, 11)
    applyStroke(track, C.border, 1)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = C.textSec
    knob.BorderSizePixel = 0
    knob.ZIndex = (zindex or 2) + 1
    knob.Parent = track
    applyCorner(knob, 8)

    local function setValue(on)
        TweenService:Create(track, TweenInfo.new(0.15), {
            BackgroundColor3 = on and C.accentD or C.raised
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = on and C.accent or C.textSec,
        }):Play()
    end

    return track, knob, setValue
end

