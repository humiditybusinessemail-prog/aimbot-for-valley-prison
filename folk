        kbBtn.BackgroundColor3 = C.accentD
        kbBtn.TextColor3 = C.accent
    end)

    clrBtn.MouseButton1Click:Connect(function()
        if listeningFor == captureKey then listeningFor = nil end
        Keybinds[captureKey] = Enum.KeyCode.Unknown
        updateKbBtn(captureKey)
        notify(meta.label .. " unbound", C.textSec)
    end)
end

-- ─── Input ────────────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- keybind capture (bypasses gameProcessed)
    if listeningFor and input.UserInputType == Enum.UserInputType.Keyboard then
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Escape then
            updateKbBtn(listeningFor)
            listeningFor = nil
            return
        end
        Keybinds[listeningFor] = kc
        notify(listeningFor .. " → " .. keybindName(kc), C.accent)
        updateKbBtn(listeningFor)
        listeningFor = nil
        return
    end

    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        local kc = input.KeyCode
        local function fire(bindKey, action)
            if Keybinds[bindKey] ~= Enum.KeyCode.Unknown and kc == Keybinds[bindKey] then
                action()
            end
        end

        fire("ToggleAimbot", function()
            aimbotEnabled = not aimbotEnabled
            statusDot.BackgroundColor3 = aimbotEnabled and C.green or C.red
            if toggleSetters["Aimbot"] then toggleSetters["Aimbot"](aimbotEnabled) end
            notify(aimbotEnabled and "Aimbot on" or "Aimbot off",
                aimbotEnabled and C.green or C.red)
        end)
        fire("ToggleTeam", function()
            teamCheck = not teamCheck
            if toggleSetters["Team Check"] then toggleSetters["Team Check"](teamCheck) end
            notify("Team Check " .. (teamCheck and "on" or "off"))
        end)
        fire("ToggleWall", function()
            wallCheck = not wallCheck
            if toggleSetters["Wall Check"] then toggleSetters["Wall Check"](wallCheck) end
            notify("Wall Check " .. (wallCheck and "on" or "off"))
        end)
        fire("TogglePredict", function()
            autoPredict = not autoPredict
            if toggleSetters["Auto-Predict"] then toggleSetters["Auto-Predict"](autoPredict) end
            notify("Auto-Predict " .. (autoPredict and "on" or "off"))
        end)
        fire("ToggleFOVVis", function()
            fovVisible = not fovVisible
            if toggleSetters["FOV Visible"] then toggleSetters["FOV Visible"](fovVisible) end
            notify("FOV circle " .. (fovVisible and "on" or "off"))
        end)
        fire("CycleAimPart", function()
            aimPartIndex = (aimPartIndex % #AIM_PARTS) + 1
            updateAimPartLabel()
            notify("Aim → " .. AIM_PARTS[aimPartIndex])
        end)

    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        holdingRMB = true
        lockedTarget = nil
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holdingRMB = false
        lockedTarget = nil
    end
end)

