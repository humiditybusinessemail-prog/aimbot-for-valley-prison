-- ─── Shared Row Builders ─────────────────────────────────────────────────────
local ROW_H  = 32
local ROW_GAP = 6
local function rowY(n) return (n-1) * (ROW_H + ROW_GAP) end

local toggleSetters = {}

local function addToggleRow(page, n, labelText, initVal, onChange)
    local row = makeFrame(page, UDim2.new(1, 0, 0, ROW_H),
        UDim2.fromOffset(0, rowY(n)), C.surface, 3)
    applyCorner(row, 6)
    makeLabel(row, UDim2.new(1, -54, 1, 0), UDim2.fromOffset(10, 0),
        labelText, C.textPri, 13, Enum.Font.Gotham, 4)
    local track, _, setValue = makePillToggle(row, UDim2.new(1, -50, 0.5, -11), 4)
    setValue(initVal)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local newVal = onChange()
            setValue(newVal)
        end
    end)
    toggleSetters[labelText] = setValue
end

