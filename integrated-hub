local p4 = tabPages[4]

local function addSliderRow(page, n, labelText, initVal, minV, maxV, isFloat, onChanged)
    local row = makeFrame(page, UDim2.new(1, 0, 0, 44),
        UDim2.fromOffset(0, (n-1) * 52), C.surface, 3)
    applyCorner(row, 6)
    makeLabel(row, UDim2.new(0.6, 0, 0, 18),
        UDim2.fromOffset(10, 4), labelText, C.textPri, 12, Enum.Font.Gotham, 4)
    local valLbl = makeLabel(row, UDim2.new(0.4, -10, 0, 18),
        UDim2.new(0.6, 0, 0, 4), tostring(initVal), C.accent, 12,
        Enum.Font.GothamSemibold, 4)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    local trackBg = makeFrame(row, UDim2.new(1, -20, 0, 6),
        UDim2.fromOffset(10, 32), C.raised, 4)
    applyCorner(trackBg, 3)
    local hitArea = Instance.new("TextButton")
    hitArea.Size = UDim2.new(1, 0, 0, 20)
    hitArea.Position = UDim2.fromOffset(0, -7)
    hitArea.BackgroundTransparency = 1
    hitArea.Text = ""
    hitArea.ZIndex = 6
    hitArea.Parent = trackBg
    local fill = makeFrame(trackBg,
        UDim2.new((initVal - minV)/(maxV - minV), 0, 1, 0),
        UDim2.fromOffset(0, 0), C.accent, 5)
    applyCorner(fill, 3)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new((initVal - minV)/(maxV - minV), 0, 0.5, 0)
    knob.BackgroundColor3 = C.textPri
    knob.BorderSizePixel = 0
    knob.ZIndex = 6
    knob.Parent = trackBg
    applyCorner(knob, 6)
    local dragging = false
    local function updateFromX(absX)
        local rel = math.clamp(
            (absX - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        local raw = minV + rel * (maxV - minV)
        local val = isFloat
            and (math.floor(raw * 100 + 0.5) / 100)
            or  math.floor(raw + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(val)
        onChanged(val)
    end
    hitArea.MouseButton1Down:Connect(function()
        dragging = true
        window.Draggable = false
        updateFromX(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            window.Draggable = true
        end
    end)
end

