local p5 = tabPages[5]
local kbBtnRefs = {}

local function keybindName(kc)
    if kc == Enum.KeyCode.Unknown then return "---" end
    return tostring(kc):match("KeyCode%.(.+)") or "?"
end

local function updateKbBtn(key)
    if kbBtnRefs[key] then
        kbBtnRefs[key].Text = keybindName(Keybinds[key])
        kbBtnRefs[key].BackgroundColor3 = C.raised
        kbBtnRefs[key].TextColor3 = C.textPri
    end
end

for i, meta in ipairs(KeybindMeta) do
    local row = makeFrame(p5, UDim2.new(1, 0, 0, ROW_H),
        UDim2.fromOffset(0, rowY(i)), C.surface, 3)
    applyCorner(row, 6)
    makeLabel(row, UDim2.new(0, 130, 1, 0), UDim2.fromOffset(10, 0),
        meta.label, C.textPri, 12, Enum.Font.Gotham, 4)
    local kbBtn = makeBtn(row, UDim2.fromOffset(72, 22),
        UDim2.new(1, -98, 0.5, -11), keybindName(Keybinds[meta.key]), 4)
    kbBtn.TextSize = 11
    kbBtn.Font = Enum.Font.GothamSemibold
    kbBtnRefs[meta.key] = kbBtn
    local clrBtn = makeBtn(row, UDim2.fromOffset(20, 22),
        UDim2.new(1, -24, 0.5, -11), "x", 4)
    clrBtn.TextSize = 10
    clrBtn.Font = Enum.Font.GothamBold
    clrBtn.BackgroundColor3 = Color3.fromRGB(80, 28, 28)
    clrBtn.TextColor3 = C.red
    local captureKey = meta.key
    kbBtn.MouseButton1Click:Connect(function()
        if listeningFor == captureKey then
            listeningFor = nil
            updateKbBtn(captureKey)
            return
        end
        if listeningFor then updateKbBtn(listeningFor) end
        listeningFor = captureKey
        kbBtn.Text = "..."
        kbBtn.BackgroundColor3 = C.accentD
        kbBtn.TextColor3 = C.accent
    end)
    clrBtn.MouseButton1Click:Connect(function()
        if listeningFor == captureKey then listeningFor = nil end
        Keybinds[captureKey] = Enum.KeyCode.Unknown
        updateKbBtn(captureKey)
        notify(meta.label .. " unbound", C.textSec)
    end)
end

-- ─── Input ────────────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if listeningFor and input.UserInputType == Enum.UserInputType.Keyboard then
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Escape then
            updateKbBtn(listeningFor)
            listeningFor = nil
            return
        end
        Keybinds[listeningFor] = kc
        notify(listeningFor .. " -> " .. keybindName(kc), C.accent)
        updateKbBtn(listeningFor)
        listeningFor = nil
        return
    end
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local kc = input.KeyCode
