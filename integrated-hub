        fovFrame.Size = UDim2.fromOffset(fov * 2, fov * 2)
        fovFrame.Visible = true
    end
end

-- ─── Aimbot Helpers ───────────────────────────────────────────────────────────
local function isIgnoredPart(part)
    if not part or not part:IsA("BasePart") then return false end
    if part.Transparency == 1 then
        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("Texture") or child:IsA("Decal") or child:IsA("SurfaceAppearance") then
                return false
            end
        end
        return true
    end
    return false
end

local function isVisible(targetPart)
    if not wallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    rp.IgnoreWater = true
    local attempts = 0
    local result = workspace:Raycast(origin, direction, rp)
    while result and attempts < 12 do
        local hit = result.Instance
        if not hit then break end
        if hit:IsDescendantOf(targetPart.Parent) then return true end
        if isIgnoredPart(hit) then
            attempts += 1
            local newOrigin = result.Position + direction.Unit * 0.1
            table.insert(rp.FilterDescendantsInstances, hit)
            direction = targetPart.Position - newOrigin
            result = workspace:Raycast(newOrigin, direction, rp)
        else
            return false
        end
    end
    return result == nil
end

local function getPingSeconds()
    local item = Stats and Stats.Network and Stats.Network.ServerStatsItem
        and Stats.Network.ServerStatsItem["Data Ping"]
    if item then
        local n = tonumber((item:GetValueString() or ""):match("%d+"))
        if n then return n / 1000 end
    end
    return 0.05
end

local function getVelocityFromChar(char)
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local ok, vel = pcall(function() return hrp.AssemblyLinearVelocity end)
        if ok and vel then return vel end
        return hrp.Velocity
    end
    return Vector3.zero
end

local function isEnemy(plr)
    if not teamCheck then return true end
    if not LocalPlayer.Team or not plr.Team then return false end
    local neutral  = {["Menu"]=true,["Civilian"]=true}
    local friendly = {["Sheriff's Office"]=true,["Department of Corrections"]=true,
                      ["State Police"]=true,["VCSO-SWAT"]=true,["WeaponsTester"]=true}
    local enemy    = {["Booking"]=true,["Escapee"]=true,["Maximum Security"]=true,
                      ["Medium Security"]=true,["Minimum Security"]=true,["Mental Patient"]=true}
    local my = LocalPlayer.Team.Name
    local tg = plr.Team.Name
    if neutral[my] or neutral[tg] then return false end
    if friendly[my] then return enemy[tg] == true end
    if enemy[my]    then return friendly[tg] == true end
    return false
end

local function resolveAimPart(char)
    local part = char:FindFirstChild(AIM_PARTS[aimPartIndex])
    if part then return part end
    for _, name in ipairs(AIM_PARTS) do
        local p = char:FindFirstChild(name)
        if p then return p end
    end
    return nil
end

local function getClosestTarget()
    local closest, dist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum  = char:FindFirstChildOfClass("Humanoid")
            local part = resolveAimPart(char)
            if hum and hum.Health > 0 and part and isEnemy(plr) then
                local v3, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and isVisible(part) then
                    local mouse = UserInputService:GetMouseLocation()
                    local mag   = (Vector2.new(v3.X, v3.Y) - mouse).Magnitude
                    if mag < fov and mag < dist then
                        dist = mag
                        closest = part
                    end
                end
            end
        end
    end
    return closest
end

-- ─── Player ESP Core ──────────────────────────────────────────────────────────
local function getTeamColor(plr)
    if plr.Team and plr.TeamColor then
        return plr.TeamColor.Color
    end
    return Color3.fromRGB(200, 200, 200)
end

local function buildPlayerESP(plr)
    if playerESPObjects[plr] then return end
    local char = plr.Character
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.Name = "HubPlayerHL"
    hl.FillColor = getTeamColor(plr)
    hl.OutlineColor = getTeamColor(plr)
    hl.FillTransparency = 0.45
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = playerESPEnabled and playerChams
    hl.Parent = char

    local hrp = char:WaitForChild("HumanoidRootPart", 4)
    local billboard, nameLabel
    if hrp then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "HubPlayerBB"
        billboard.Size = UDim2.fromOffset(120, 20)
        billboard.StudsOffset = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = playerESPEnabled and playerNames
        billboard.Parent = hrp

        nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.DisplayName
        nameLabel.TextColor3 = getTeamColor(plr)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 13
        nameLabel.TextStrokeTransparency = 0.4
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.Parent = billboard
    end

    playerESPObjects[plr] = {highlight = hl, billboard = billboard, nameLabel = nameLabel}
end

local function removePlayerESP(plr)
    local obj = playerESPObjects[plr]
    if not obj then return end
    if obj.highlight and obj.highlight.Parent then obj.highlight:Destroy() end
    if obj.billboard and obj.billboard.Parent then obj.billboard:Destroy() end
    playerESPObjects[plr] = nil
end

local function refreshPlayerColors(plr)
    local obj = playerESPObjects[plr]
    if not obj then return end
    local col = getTeamColor(plr)
    if obj.highlight then
        obj.highlight.FillColor    = col
        obj.highlight.OutlineColor = col
    end
    if obj.nameLabel then
        obj.nameLabel.TextColor3 = col
    end
end

-- defined earlier so keybind fire can call it
local function refreshAllPlayerESP_actual()
    for _, obj in pairs(playerESPObjects) do
        if obj.highlight then
            obj.highlight.Enabled = playerESPEnabled and playerChams
        end
        if obj.billboard then
            obj.billboard.Enabled = playerESPEnabled and playerNames
        end
    end
end

local function hookPlayer(plr)
    if plr == LocalPlayer then return end
    local function onChar()
        task.wait(0.2)
        removePlayerESP(plr)
        buildPlayerESP(plr)
    end
    if plr.Character then onChar() end
    plr.CharacterAdded:Connect(onChar)
    plr:GetPropertyChangedSignal("Team"):Connect(function()
        refreshPlayerColors(plr)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(function(plr) removePlayerESP(plr) end)

-- ─── Bin ESP Core ─────────────────────────────────────────────────────────────
local function isAvailable(binModel)
    local stocked = binModel:GetAttribute("Stocked")
    if stocked == nil then return false end
    return stocked == true
end

local function buildBinESP(binModel)
    if trackedBins[binModel] then return end

    local hl = Instance.new("Highlight")
    hl.Name = "HubBinHL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.Parent = binModel

    local rootPart = binModel:FindFirstChildWhichIsA("BasePart")
    local billboard, tagLabel, statusLabel

    if rootPart then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "HubBinBB"
        billboard.Size = UDim2.fromOffset(120, 36)
        billboard.StudsOffset = Vector3.new(0, 4, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = rootPart

        tagLabel = Instance.new("TextLabel")
        tagLabel.Size = UDim2.new(1, 0, 0.55, 0)
        tagLabel.BackgroundTransparency = 1
        tagLabel.Text = binModel.Name
        tagLabel.TextColor3 = C.textPri
        tagLabel.Font = Enum.Font.GothamBold
        tagLabel.TextSize = 13
        tagLabel.TextStrokeTransparency = 0.3
        tagLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        tagLabel.Parent = billboard

        statusLabel = Instance.new("TextLabel")
        statusLabel.Size = UDim2.new(1, 0, 0.45, 0)
        statusLabel.Position = UDim2.new(0, 0, 0.55, 0)
        statusLabel.BackgroundTransparency = 1
        statusLabel.Text = "Available"
        statusLabel.TextColor3 = C.green
        statusLabel.Font = Enum.Font.GothamSemibold
        statusLabel.TextSize = 11
        statusLabel.TextStrokeTransparency = 0.3
        statusLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        statusLabel.Parent = billboard
    end

    local attrConn = binModel:GetAttributeChangedSignal("Stocked"):Connect(function() end)

    trackedBins[binModel] = {
        highlight   = hl,
        billboard   = billboard,
        tagLabel    = tagLabel,
        statusLabel = statusLabel,
        attrConn    = attrConn,
    }
end

local function removeBinESP(binModel)
    local t = trackedBins[binModel]
    if not t then return end
    if t.highlight and t.highlight.Parent then t.highlight:Destroy() end
    if t.billboard and t.billboard.Parent then t.billboard:Destroy() end
    if t.attrConn then t.attrConn:Disconnect() end
    trackedBins[binModel] = nil
end

local function scanBins()
    local folder = workspace:FindFirstChild(BIN_FOLDER)
    if not folder then return end
    for _, desc in ipairs(folder:GetDescendants()) do
        if desc:IsA("Model") or desc:IsA("BasePart") then
            for _, binName in ipairs(BIN_NAMES) do
                if desc.Name == binName then
                    buildBinESP(desc)
                    break
                end
            end
        end
    end
end

task.defer(scanBins)

local binFolder = workspace:FindFirstChild(BIN_FOLDER)
if binFolder then
    binFolder.DescendantAdded:Connect(function()
        task.defer(scanBins)
    end)
end

-- ─── Main Loop ────────────────────────────────────────────────────────────────
RunService.RenderStepped:Connect(function()
    updateCircle()
    if not fovVisible then setFOVVisible(false) end

    if aimbotEnabled and holdingRMB then
        local lockValid = lockedTarget
            and lockedTarget.Parent
            and lockedTarget:IsDescendantOf(workspace)
            and lockedTarget.Name == AIM_PARTS[aimPartIndex]
        if not lockValid then
            lockedTarget = getClosestTarget()
        end
        if lockedTarget then
            local desiredPos = lockedTarget.Position
            if autoPredict then
                local vel = getVelocityFromChar(lockedTarget.Parent)
                desiredPos = lockedTarget.Position + vel * getPingSeconds()
            end
            local current = Camera.CFrame
            local desired = CFrame.new(current.Position, desiredPos)
            local alpha   = math.clamp(1 - smoothness, 0.05, 1)
            Camera.CFrame = current:Lerp(desired, alpha)
            local hum = lockedTarget.Parent
                and lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then
                lockedTarget = nil
            end
        end
    end
end)

-- ─── Heartbeat: ESP sync ─────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    -- player ESP color sync + enabled state
    for plr, obj in pairs(playerESPObjects) do
        if plr.Team then refreshPlayerColors(plr) end
        if obj.highlight then
            obj.highlight.Enabled = playerESPEnabled and playerChams
        end
        if obj.billboard then
            obj.billboard.Enabled = playerESPEnabled and playerNames
        end
    end

    -- bin ESP
    if not binESPEnabled then
        for _, t in pairs(trackedBins) do
            if t.highlight then t.highlight.Enabled = false end
            if t.billboard then t.billboard.Enabled = false end
        end
        availCountLbl.Text = "0"
        return
    end

    local availableCount = 0
    for binModel, t in pairs(trackedBins) do
        if not binModel.Parent then
            removeBinESP(binModel)
        else
            local avail = isAvailable(binModel)
            if avail then availableCount += 1 end
            local shouldShow = (avail and showAvailable) or (not avail and showCooldown)
            if t.highlight then
                t.highlight.Enabled      = shouldShow
                t.highlight.FillColor    = avail and C.available or C.cooldown
                t.highlight.OutlineColor = avail and C.available or C.cooldown
            end
            if t.billboard then
                t.billboard.Enabled = billboardEnabled and shouldShow
            end
            if t.statusLabel then
                t.statusLabel.Text       = avail and "Available" or "Cooldown"
                t.statusLabel.TextColor3 = avail and C.green or C.red
            end
        end
    end
    availCountLbl.Text = tostring(availableCount)
end)
