Instance.new("UICorner", notifLbl).CornerRadius = UDim.new(0, 8)

local function notify(text, color)
    notifLbl.Text = text
    notifLbl.TextColor3 = color or Color3.new(1, 1, 1)
    notifLbl.Visible = true
    TweenService:Create(notifLbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
    task.delay(1.4, function()
        TweenService:Create(notifLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        task.delay(0.4, function() notifLbl.Visible = false end)
    end)
end

-- // ─── Toggle logic ────────────────────────────────────────────────────────

local function refreshAllESP()
    for _, obj in pairs(espObjects) do
        if obj.highlight then
            obj.highlight.Enabled = espEnabled and chamsEnabled
        end
        if obj.billboard then
            obj.billboard.Enabled = espEnabled and namesEnabled
        end
    end
end

local function toggleESP()
    espEnabled = not espEnabled
    espToggleBtn.Text = "ESP: " .. (espEnabled and "ON" or "OFF")
    notify("ESP " .. (espEnabled and "ON" or "OFF"),
        espEnabled and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 80, 80))
    refreshAllESP()
end

espToggleBtn.MouseButton1Click:Connect(toggleESP)

chamsToggleBtn.MouseButton1Click:Connect(function()
    chamsEnabled = not chamsEnabled
    chamsToggleBtn.Text = "Chams: " .. (chamsEnabled and "ON" or "OFF")
    notify("Chams " .. (chamsEnabled and "ON" or "OFF"))
    for _, obj in pairs(espObjects) do
        if obj.highlight then
            obj.highlight.Enabled = espEnabled and chamsEnabled
        end
    end
end)

namesToggleBtn.MouseButton1Click:Connect(function()
    namesEnabled = not namesEnabled
    namesToggleBtn.Text = "Names: " .. (namesEnabled and "ON" or "OFF")
    notify("Names " .. (namesEnabled and "ON" or "OFF"))
    for _, obj in pairs(espObjects) do
        if obj.billboard then
            obj.billboard.Enabled = espEnabled and namesEnabled
        end
    end
end)

-- // ─── Keybind logic ───────────────────────────────────────────────────────

kbBtn.MouseButton1Click:Connect(function()
    if listeningForBind then
        -- cancel
        listeningForBind = false
        kbBtn.Text = keybindName(espKeybind)
        kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        return
    end
    listeningForBind = true
    kbBtn.Text = "[ press key ]"
    kbBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 20)
end)

kbClear.MouseButton1Click:Connect(function()
    listeningForBind = false
    espKeybind = Enum.KeyCode.Unknown
    kbBtn.Text = keybindName(espKeybind)
    kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    notify("ESP keybind cleared")
end)

-- // ─── Input ───────────────────────────────────────────────────────────────

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- capture mode: intercepts before gameProcessed check
    if listeningForBind and input.UserInputType == Enum.UserInputType.Keyboard then
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Escape then
            listeningForBind = false
            kbBtn.Text = keybindName(espKeybind)
            kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            return
        end
        espKeybind = kc
        kbBtn.Text = keybindName(espKeybind)
        kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        listeningForBind = false
        notify("ESP keybind → " .. keybindName(kc), Color3.fromRGB(120, 200, 255))
        return
    end

    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if espKeybind ~= Enum.KeyCode.Unknown and input.KeyCode == espKeybind then
            toggleESP()
        end
    end
end)

-- // ─── ESP Core ────────────────────────────────────────────────────────────

local function getTeamColor(plr)
    if plr.Team and plr.TeamColor then
        return plr.TeamColor.Color
    end
    return Color3.fromRGB(200, 200, 200)
end

local function buildESP(plr)
    local char = plr.Character
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.Name = "ESPHighlight"
    hl.FillColor = getTeamColor(plr)
    hl.OutlineColor = getTeamColor(plr)
    hl.FillTransparency = 0.45
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = espEnabled and chamsEnabled
    hl.Parent = char

    local hrp = char:WaitForChild("HumanoidRootPart", 4)
    local billboard, nameLabel
    if hrp then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPBillboard"
        billboard.Size = UDim2.fromOffset(120, 20)
        billboard.StudsOffset = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = espEnabled and namesEnabled
        billboard.Parent = hrp

        nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.DisplayName
        nameLabel.TextColor3 = getTeamColor(plr)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 13
        nameLabel.TextStrokeTransparency = 0.4
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.Parent = billboard
    end

    espObjects[plr] = { highlight = hl, billboard = billboard, nameLabel = nameLabel }
end

local function removeESP(plr)
    local obj = espObjects[plr]
    if not obj then return end
    if obj.highlight and obj.highlight.Parent then obj.highlight:Destroy() end
    if obj.billboard and obj.billboard.Parent then obj.billboard:Destroy() end
    espObjects[plr] = nil
end

local function refreshColors(plr)
    local obj = espObjects[plr]
    if not obj then return end
    local col = getTeamColor(plr)
    if obj.highlight then
        obj.highlight.FillColor    = col
        obj.highlight.OutlineColor = col
    end
    if obj.nameLabel then
        obj.nameLabel.TextColor3 = col
    end
end

local function hookPlayer(plr)
    if plr == LocalPlayer then return end

    local function onChar()
        task.wait(0.2)
        removeESP(plr)
        buildESP(plr)
    end

    if plr.Character then onChar() end
    plr.CharacterAdded:Connect(onChar)

    plr:GetPropertyChangedSignal("Team"):Connect(function()
        refreshColors(plr)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

Players.PlayerAdded:Connect(hookPlayer)

Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
end)

RunService.Heartbeat:Connect(function()
    for plr in pairs(espObjects) do
        if plr.Team then
            refreshColors(plr)
        end
    end
end)
